# Backend Environment (AuditViel)

# Server
NODE_ENV=development
PORT=10000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Chain
CHAIN_ID=80002
RPC_URL=https://polygon-amoy.infura.io/v3/YOUR_INFURA_KEY

# Wallet Keys (hex, with or without 0x)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key
ADMIN_PRIVATE_KEY=your_admin_private_key
PROOF_SIGNER_PRIVATE_KEY=your_proof_signer_private_key
TRUSTED_PROVER_PRIVATE_KEY=your_trusted_prover_private_key
TRUSTED_PROVER_ADDRESS=0xYourTrustedProverAddress

# Contracts
AUDITOR_REGISTRY_ADDRESS=0xYourAuditorRegistryAddress
PROOF_VERIFIER_ADDRESS=0xYourProofVerifierAddress
ZK_VERIFIER_ADDRESS=0xYourZKVerifierAddress
CONTRACT_ADDRESS=0xYourProofVerifierAddress

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/auditviel?retryWrites=true&w=majority

# Auth
ADMIN_JWT_SECRET=replace_with_long_random_secret_min_32_chars
ADMIN_JWT_TTL=30m

# Optional
POLYGONSCAN_API_KEY=
